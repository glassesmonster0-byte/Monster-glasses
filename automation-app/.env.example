# LIAXIS Ürün Otomasyon Paneli — ortam değişkenleri
# Bu dosyayı .env.local olarak kopyalayın ve gerçek değerlerinizi girin.
# HİÇBİR anahtarı .env.example dışında koda veya git'e eklemeyin.

# ---- Genel ----
# SQLite veritabanı dosya yolu (varsayılan: ./data/liaxis.db)
DATABASE_PATH=./data/liaxis.db

# ---- Modül 2: Fiyat Araştırma (SerpApi — Google Shopping) ----
# https://serpapi.com/ üzerinden ücretsiz/ücretli plan ile alınır.
SERPAPI_API_KEY=

# Varsayılan kâr marjı yüzdesi (panelde değiştirilebilir, bu sadece ilk değer)
DEFAULT_MARKUP_PERCENT=150

# ---- Modül 3: Shopify Admin API ----
# Shopify admin panel > Settings > Apps and sales channels > Develop apps
# ile bir "custom app" oluşturup Admin API erişim token'ı alın.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_API_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01
# Opsiyonel — verilirse yeni ürünler otomatik bu koleksiyona eklenir
# (Shopify admin'de koleksiyon URL'sindeki gid://shopify/Collection/XXXX değeri)
SHOPIFY_DEFAULT_COLLECTION_ID=
# Opsiyonel — verilirse envanter bu stok konumuna göre ayarlanır
# (Settings > Locations sayfasındaki konum ID'si)
SHOPIFY_LOCATION_ID=
SHOPIFY_DEFAULT_INVENTORY_QUANTITY=10

# ---- Modül 4: AI Görsel/Video Üretimi (doğrudan Google + Kling, aracı servis yok) ----

# Görsel: Nano Banana Pro (Gemini 3 Pro Image) — doğrudan Google AI Studio /
# Gemini Developer API üzerinden. Video: Google Veo 3.1 (aynı API anahtarıyla).
# Anahtarı https://aistudio.google.com/apikey adresinden alın.
# ÖNEMLİ: Nano Banana Pro ve Veo 3.1'in Gemini API üzerinde ÜCRETSİZ KOTASI
# YOKTUR — her çağrı, API anahtarınızın bağlı olduğu Google Cloud projesinde
# faturalandırma etkinse ücretli olarak yürütülür, değilse hata döner.
# Uygulama hiçbir zaman "ücretsizden ücretliye" sessizce geçmez (böyle bir
# geçiş API seviyesinde mümkün değil); kota/faturalama hatalarını panelde
# açıkça gösterir.
GOOGLE_AI_API_KEY=
GOOGLE_IMAGE_MODEL=gemini-3-pro-image-preview
GOOGLE_VEO_MODEL=veo-3.1-generate-001

# Video (alternatif): Kling AI — doğrudan app.klingai.com üzerinden.
# Kling tek bir opak API key değil, access key + secret key çifti kullanır
# (app.klingai.com > API Key sayfasından alınır).
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_VIDEO_MODEL=kling-v2.6-i2v

# Panelin sağ üstündeki dropdown'dan değiştirilebilir; bu sadece ilk değer.
# "veo" veya "kling"
DEFAULT_VIDEO_PROVIDER=veo

# ---- Modül 5: Meta Graph API (Instagram Business + Facebook Sayfa) ----
# https://developers.facebook.com/ üzerinden bir uygulama oluşturup
# Instagram Business hesabınızı ve Facebook Sayfanızı bağlayın.
META_GRAPH_API_VERSION=v21.0
META_PAGE_ACCESS_TOKEN=
META_FACEBOOK_PAGE_ID=
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ---- Uygulama ----
# Yüklenen kaynak görsellerin ve üretilen içeriklerin diskte tutulacağı klasör
MEDIA_STORAGE_PATH=./data/media
