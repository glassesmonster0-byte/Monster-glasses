<section class="hero" id="hero">
  <div class="hero__bg">
    {%- if section.settings.background_image -%}
      <img src="{{ section.settings.background_image | image_url: width: 1800 }}" alt="" loading="eager" width="{{ section.settings.background_image.width }}" height="{{ section.settings.background_image.height }}">
    {%- else -%}
      <img src="{{ 'onyx-editorial.webp' | asset_url }}" alt="" loading="eager" width="640" height="1147">
    {%- endif -%}
  </div>
  <div class="hero__scrim"></div>
  <div class="hero__content">
    <p class="eyebrow reveal">{{ section.settings.eyebrow }}</p>
    <h1 class="hero__title">
      <span class="reveal" style="--d:0">{{ shop.name | default: 'Foldsun' | upcase }}</span>
    </h1>
    <p class="hero__sub reveal" style="--d:1">{{ section.settings.subtitle }}</p>
    <p class="hero__tagline reveal" style="--d:2">{{ section.settings.tagline }}</p>
  </div>
  <div class="scrollcue">
    <span>Kaydır</span>
    <i></i>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Arka plan görseli"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Üst etiket",
      "default": "El Yapımı Gözlük — Vine Koleksiyonu No.07"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Alt başlık",
      "default": "Vine Koleksiyonu"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Slogan",
      "default": "Tek siluet. Altı ton. İnce metalden dökülmüş, burma dal desenli bir tapa."
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
